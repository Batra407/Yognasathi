# ==============================================================================
# YojanaSathi Production Environment Variables
# Copy this file to .env or set these in your hosting environment (Vercel, Railway, Docker, AWS)
# ==============================================================================

# 1. Environment & Server
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL="https://yojanasathi.in"

# 2. Database Connection
# PostgreSQL Connection URL (for connection pooling via PgBouncer / Supabase / AWS RDS):
# Add ?connection_limit=10&pool_timeout=20 for high-concurrency production deployments
DATABASE_URL="postgresql://username:password@localhost:5432/gov_schemes_db?schema=public&connection_limit=10"

# 3. Official Government API Setu Credentials (Consumer Portal)
# Obtain from: https://apisetu.gov.in
APISETU_CLIENT_ID=
APISETU_API_KEY=

# 4. Telemetry & Analytics (Optional)
NEXT_TELEMETRY_DISABLED=1
